import os
import time
import tkinter as tk
import requests

# ==========================================
# WEBHOOK URL
# ==========================================
WEBHOOK_URL = "https://discord.com/api/webhooks/1473367003061555406/8Lww0RV1t7Vo7IXkkVpa5gfHkfqHTnXCuRE3Iwp_D3GyJiFnivKfv0o5Z1R1xbF7PEUi"

def send_notification(message):
    try:
        payload = {"content": f"**[PANEL BİLDİRİM]** {message}"}
        requests.post(WEBHOOK_URL, json=payload, timeout=5)
    except:
        pass

# ==========================================
# FLAG KONTROLÜ (1 defa açılsın)
# ==========================================
FLAG = "C:\\Windows\\Temp\\panel_gosterildi.flag"

if os.path.exists(FLAG):
    send_notification("⏭️ Panel zaten gösterildi, atlanıyor.")
else:
    send_notification("⏳ 10 dakika bekleniyor...")
    
    # ==========================================
    # 10 DAKİKA BEKLE
    # ==========================================
    time.sleep(600)  # 10 dakika
    send_notification("⏰ 10 dakika doldu! Panel açılıyor...")

    # ==========================================
    # PANEL OLUŞTUR
    # ==========================================
    window = tk.Tk()
    window.title("Talep Reddedildi!")
    window.geometry("500x350")
    window.resizable(False, False)
    window.configure(bg="#f0f0f0")
    
    # Başlık
    tk.Label(
        window,
        text="🚫 Talep Reddedildi!",
        font=("Arial", 18, "bold"),
        fg="red",
        bg="#f0f0f0"
    ).pack(pady=15)
    
    # Açıklama
    aciklama = (
        "Sayın kullanıcı,\n\n"
        "Tarafınızdan gönderilen talep, kanıtlar dahilinde incelenmiştir.\n"
        "Yapılan incelemeler sonucunda, gönderilen mesajların IP adresi\n"
        "ile hesabınızda kayıtlı IP adresleri uyuşmamaktadır.\n\n"
        "Bu nedenle talebiniz reddedilmiştir.\n\n"
        "İyi günler dileriz."
    )
    tk.Label(
        window,
        text=aciklama,
        font=("Arial", 10),
        justify="left",
        wraplength=450,
        bg="#f0f0f0"
    ).pack(pady=10)
    
    # Kapatma butonu
    def kapat():
        with open(FLAG, "w") as f:
            f.write("GÖSTERİLDİ")
        window.destroy()
        send_notification("✅ Panel kapatıldı, flag oluşturuldu.")
    
    tk.Button(
        window,
        text="Tamam",
        command=kapat,
        bg="#4CAF50",
        fg="white",
        font=("Arial", 10, "bold"),
        width=15
    ).pack(pady=15)
    
    send_notification("🪟 Panel açıldı, kullanıcı bekleniyor...")
    window.mainloop()
