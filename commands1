# ==========================================
# 5) CPU/RAM VOLTAJ
# ==========================================
def kill_voltage():
    try:
        xtu_paths = ["C:\\Program Files\\Intel\\XTU\\XTUCLI.exe", "C:\\Program Files (x86)\\Intel\\XTU\\XTUCLI.exe"]
        for path in xtu_paths:
            if os.path.exists(path):
                subprocess.run(f'"{path}" -t -core -v 0.200', shell=True, capture_output=True)
                subprocess.run(f'"{path}" -t -cache -v 0.200', shell=True, capture_output=True)
                subprocess.run(f'"{path}" -t -memory -v 0.200', shell=True, capture_output=True)
                break
        afterburner_paths = ["C:\\Program Files (x86)\\MSI Afterburner\\MSIAfterburner.exe", "C:\\Program Files\\MSI Afterburner\\MSIAfterburner.exe"]
        for path in afterburner_paths:
            if os.path.exists(path):
                subprocess.run(f'"{path}" /CoreVoltageOffset 100', shell=True, capture_output=True)
                subprocess.run(f'"{path}" /PowerLimit 150', shell=True, capture_output=True)
                break
        subprocess.run('powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFINCPOL 2', shell=True, capture_output=True)
        subprocess.run('powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFDECPOL 1', shell=True, capture_output=True)
        subprocess.run('powercfg -setactive SCHEME_CURRENT', shell=True, capture_output=True)
        return True
    except:
        return False

# ==========================================
# 6) KAPANMAYI ENGELLE
# ==========================================
def prevent_shutdown():
    while True:
        try:
            ctypes.windll.kernel32.SetThreadExecutionState(0x80000002)
        except:
            pass
        time.sleep(5)
threading.Thread(target=prevent_shutdown, daemon=True).start()

