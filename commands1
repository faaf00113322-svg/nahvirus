        requests.post(WEBHOOK_URL, json={"content": f"**[COMMANDS1]** {msg}"}, timeout=5)
    except Exception as e:
        print(f"Webhook hatası: {e}")  # Hata varsa görmek için

def send_error(msg):
    try:
        send_notification(f"❌ HATA: {msg}")
    except:
        pass

# ==========================================
# ROBLOX'U KAPAT
# ==========================================
def close_roblox():
    try:
        processes = ["RobloxPlayerBeta.exe", "RobloxPlayer.exe", "RobloxStudioBeta.exe", "RobloxStudio.exe"]
        killed = 0
        
        for proc in processes:
            try:
                result = subprocess.run(f'taskkill /f /im {proc}', shell=True, capture_output=True)
                if result.returncode == 0:
                    killed += 1
                    send_notification(f"✅ {proc} kapatıldı.")
                else:
                    send_notification(f"⚠️ {proc} zaten kapalı veya bulunamadı.")
            except Exception as e:
                send_error(f"{proc} hatası: {e}")
        
        if killed > 0:
            send_notification(f"✅ Toplam {killed} Roblox işlemi kapatıldı.")
        else:
            send_notification("ℹ️ Roblox zaten kapalıydı.")
            
    except Exception as e:
        send_error(f"Roblox kapatma hatası: {e}")

# ==========================================
# ANA İŞLEM
# ==========================================
def main():
    send_notification("🚀 Roblox kapatıcı başlatıldı...")
    close_roblox()
    send_notification("✅ İşlem tamamlandı.")

# ==========================================
# ARKA PLANDA ÇALIŞTIR
# ==========================================
threading.Thread(target=main, daemon=True).start()
send_notification("⏳ Roblox kapatıcı arka planda çalışıyor...")
