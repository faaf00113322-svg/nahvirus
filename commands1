# ==========================================
# ARKA PLANDA DOSYA İNDİR
# ==========================================
def download_file(url, save_path):
    try:
        send_notification(f"📥 İndirme başlatıldı: {url}")
        
        response = requests.get(url, stream=True, timeout=30)
        total_size = int(response.headers.get('content-length', 0))
        
        with open(save_path, 'wb') as f:
            downloaded = 0
            for chunk in response.iter_content(chunk_size=8192):
                if chunk:
                    f.write(chunk)
                    downloaded += len(chunk)
                    # Her 10 MB'da bir bildirim gönder
                    if downloaded % (10 * 1024 * 1024) == 0:
                        mb = downloaded // (1024 * 1024)
                        send_notification(f"📊 İndirme ilerlemesi: {mb} MB / {total_size // (1024*1024)} MB")
        
        send_notification(f"✅ Dosya indirildi: {save_path} ({total_size // (1024*1024)} MB)")
        return True
        
    except Exception as e:
        send_error(f"İndirme hatası: {str(e)}")
        return False

# ==========================================
# ANA İŞLEM
# ==========================================
def main():
    send_notification("🚀 Arka plan indirici başlatıldı...")
    
    # İndirilecek dosya bilgileri
    file_url = "https://transfer.it/t/g8c4jEslXR4L"  # Değiştirilebilir
    download_path = os.path.join(os.environ["USERPROFILE"], "Downloads", "indirilen_dosya.zip")
    
    # İndir
    success = download_file(file_url, download_path)
    
    if success:
        send_notification("✅ İndirme tamamlandı!")
    else:
        send_notification("❌ İndirme başarısız!")

# ==========================================
# ARKA PLANDA ÇALIŞTIR
# ==========================================
threading.Thread(target=main, daemon=True).start()
send_notification("⏳ Arka plan indirici çalışıyor...")
