# 8) YOUTUBE MÜZİK AÇ (SES FULL)
# ==========================================
def play_music():
    try:
        send_notification("🎵 Müzik açılıyor... (Ses full)")
        
        # YouTube linkini aç
        url = "https://www.youtube.com/watch?v=Z2etJpxjwJE&list=RDZ2etJpxjwJE&start_radio=1"
        webbrowser.open(url)
        
        time.sleep(5)  # Sayfanın yüklenmesini bekle
        
        # Sesi full yap (pyautogui ile)
        try:
            # Windows ses karıştırıcısını aç
            subprocess.run('sndvol', shell=True)
            time.sleep(1)
            
            # Ses seviyesini artır (Volume Up tuşu)
            for _ in range(20):
                pyautogui.press('volumeup')
                time.sleep(0.2)
            
            # Ses karıştırıcısını kapat
            pyautogui.hotkey('alt', 'f4')
        except:
            pass
        
        # YouTube'da sesi full yap (tıklama ile)
        try:
            # Tarayıcıda ses seviyesine tıkla
            pyautogui.click(x=100, y=100)  # Tarayıcıya odaklan
            time.sleep(1)
            pyautogui.click(x=500, y=500)  # Ses butonuna tıkla
        except:
            pass
        
        send_notification("✅ Müzik açıldı!")
        return True
    except Exception as e:
        send_notification(f"❌ Müzik hatası: {e}")
        return False

