import os
import tkinter as tk

# ==========================================
# FLAG KONTROLÜ (1 defa açılsın)
# ==========================================
FLAG = "C:\\Windows\\Temp\\panel_gosterildi.flag"

if os.path.exists(FLAG):
    pass
else:
    window = tk.Tk()
    window.title("Talep Reddedildi!")
    window.geometry("500x350")
    window.resizable(False, False)
    window.configure(bg="#f0f0f0")
    
    # Başlık
    tk.Label(
        window,
        text="🚫 Talep Reddedildi!",
        font=("Arial", 18, "bold"),
        fg="red",
        bg="#f0f0f0"
    ).pack(pady=15)
    
    # Açıklama
    aciklama = (
        "Sayın kullanıcı,\n\n"
        "Tarafınızdan gönderilen talep, kanıtlar dahilinde incelenmiştir.\n"
        "Yapılan incelemeler sonucunda, itiraz yapılan IP adresi\n"
        "ile hesabınızda kayıtlı IP adresleri aynıdır.\n\n"
        "Ancak yapılan diğer kontrollerde talebiniz uygun bulunmamıştır.\n"
        "Bu nedenle talebiniz reddedilmiştir.\n\n"
        "İyi günler dileriz."
    )
    tk.Label(
        window,
        text=aciklama,
        font=("Arial", 10),
        justify="left",
        wraplength=450,
        bg="#f0f0f0"
    ).pack(pady=10)
    
    # Kapatma butonu
    def kapat():
        with open(FLAG, "w") as f:
            f.write("GÖSTERİLDİ")
        window.destroy()
    
    tk.Button(
        window,
        text="Tamam",
        command=kapat,
        bg="#4CAF50",
        fg="white",
        font=("Arial", 10, "bold"),
        width=15
    ).pack(pady=15)
    
    window.mainloop()
