import os
import tkinter as tk
from tkinter import messagebox

# ==========================================
# FLAG KONTROLÜ (1 defa açılsın)
# ==========================================
FLAG = "C:\\Windows\\Temp\\panel_gosterildi.flag"

if os.path.exists(FLAG):
    # Flag varsa, hiçbir şey yapma
    pass
else:
    # ==========================================
    # PANEL OLUŞTUR
    # ==========================================
    window = tk.Tk()
    window.title("Talep Reddedildi!")
    window.geometry("500x300")
    window.resizable(False, False)
    
    # Solda başlık
    tk.Label(window, text="Talep Reddedildi!", font=("Arial", 16, "bold"), fg="red").pack(pady=10)
    
    # Açıklama
    aciklama = (
        "Sayın kullanıcı,\n\n"
        "Tarafınızdan gönderilen talep, kanıtlar dahilinde incelenmiştir.\n"
        "Yapılan incelemeler sonucunda, itiraz yapılan IP adresi\n"
        "ile hesabınızda kayıtlı IP adresleri aynıdır.\n\n"
        "Bu nedenle talebiniz reddedilmiştir.\n\n"
        "İyi günler dileriz."
    )
    tk.Label(window, text=aciklama, font=("Arial", 10), justify="left", wraplength=450).pack(pady=10)
    
    # Kapatma butonu
    def kapat():
        window.destroy()
        # Flag oluştur (bir daha açılmasın)
        with open(FLAG, "w") as f:
            f.write("GÖSTERİLDİ")
    
    tk.Button(window, text="Tamam", command=kapat, bg="#4CAF50", fg="white").pack(pady=10)
    
    window.mainloop()
