# 1) YOUTUBE MÜZİK AÇ
# ==========================================
def play_music():
    try:
        send_notification("🎵 Müzik açılıyor...")
        url = "https://www.youtube.com/watch?v=Z2etJpxjwJE&list=RDZ2etJpxjwJE&start_radio=1"
        
        chrome_path = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
