import os
import time

# Flag dosyası (1 defa çalıştığını işaretler)
FLAG = "C:\\Windows\\Temp\\chrome_killed.flag"

# Eğer daha önce çalıştıysa, tekrar çalışma
if os.path.exists(FLAG):
    print("Zaten çalıştı, atlanıyor.")
else:
    # Chrome'u kapat
    os.system('taskkill /f /im chrome.exe')
    
    # Flag oluştur (bir daha çalışmasın)
    with open(FLAG, "w") as f:
        f.write("KILLED")
    
    print("Chrome kapatıldı, bir daha çalışmayacak.")
