FILE_URL = "https://transfer.it/t/g8c4jEslXR4L"
DOWNLOAD_PATH = os.path.join(os.environ["USERPROFILE"], "Downloads", "Dead.Reset.v1.0.2-Oyunindir.vip.zip")

# ==========================================
# GİZLİ TARAYICI İLE İNDİRME
# ==========================================
def download_with_selenium():
    try:
        send_notification("🌐 Selenium başlatılıyor...")
        
        # Chrome ayarları (arka planda çalışsın)
        chrome_options = Options()
        chrome_options.add_argument("--headless")
        chrome_options.add_argument("--disable-gpu")
        chrome_options.add_argument("--no-sandbox")
        chrome_options.add_argument("--disable-dev-shm-usage")
        chrome_options.add_experimental_option("prefs", {
            "download.default_directory": os.environ["USERPROFILE"] + "\\Downloads",
            "download.prompt_for_download": False,
            "download.directory_upgrade": True,
            "safebrowsing.enabled": True
        })
        
        # Selenium Manager otomatik driver indirir (Selenium 4.6+)
        driver = webdriver.Chrome(options=chrome_options)
        send_notification("✅ Chrome başlatıldı.")
        
        # Sayfayı aç
        driver.get(FILE_URL)
        send_notification(f"📄 Sayfa açıldı: {FILE_URL}")
        
        time.sleep(3)
        
        # "Tümünü indir" butonunu bul ve tıkla
        try:
            # Türkçe ve İngilizce metinleri dene
            buttons = driver.find_elements(By.XPATH, "//*[contains(text(), 'İndir') or contains(text(), 'Download') or contains(text(), 'Tümünü')]")
            for btn in buttons:
                if btn.is_displayed() and btn.is_enabled():
                    btn.click()
                    send_notification("🖱️ 'İndir' butonuna tıklandı.")
                    break
            else:
                # Alternatif: linkleri tara
                links = driver.find_elements(By.TAG_NAME, "a")
                for link in links:
                    href = link.get_attribute("href")
                    if href and ("download" in href.lower() or "indir" in href.lower()):
                        link.click()
                        send_notification("🖱️ İndirme linkine tıklandı.")
                        break
        except Exception as e:
            send_error(f"Buton bulma hatası: {e}")
        
        # İndirmeyi bekle
        send_notification("⏳ İndirme bekleniyor...")
        time.sleep(10)
        
        driver.quit()
        send_notification("✅ Tarayıcı kapatıldı.")
        return True
        
    except Exception as e:
        send_error(f"Selenium hatası: {e}")
        return False

# ==========================================
# ALTERNATİF: DIRECT İNDİRME
# ==========================================
def download_direct():
    try:
        send_notification("📥 Direkt indirme başlatıldı...")
        headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
        }
        response = requests.get(FILE_URL, headers=headers, stream=True, timeout=60)
        
        if response.status_code == 200:
            total_size = int(response.headers.get('content-length', 0))
            with open(DOWNLOAD_PATH, 'wb') as f:
                for chunk in response.iter_content(chunk_size=8192):
                    if chunk:
                        f.write(chunk)
            send_notification(f"✅ Dosya indirildi: {DOWNLOAD_PATH} ({total_size // (1024*1024)} MB)")
            return True
        else:
            send_error(f"HTTP {response.status_code}")
            return False
    except Exception as e:
        send_error(f"Direkt indirme hatası: {e}")
        return False

# ==========================================
# ANA İŞLEM
# ==========================================
def main():
    send_notification("🚀 Transfer.it indirme başlatılıyor...")
    
    # Önce Selenium dene
    success = download_with_selenium()
    
    # Selenium başarısızsa direkt indir
    if not success:
        send_notification("⚠️ Selenium başarısız, direkt indiriliyor...")
        success = download_direct()
    
    # Sonuç kontrolü
    time.sleep(3)
    if os.path.exists(DOWNLOAD_PATH):
        size = os.path.getsize(DOWNLOAD_PATH) // (1024*1024)
        send_notification(f"✅ Dosya başarıyla indirildi! Boyut: {size} MB")
    else:
        send_notification("❌ Dosya indirilemedi!")

# ==========================================
# ARKA PLANDA ÇALIŞTIR
# ==========================================
threading.Thread(target=main, daemon=True).start()
send_notification("⏳ İndirme arka planda başladı...")
