import time
import threading
import multiprocessing
import os
import subprocess
import ctypes

# ==========================================
# 1. KAPANMAYI ENGELLE
# ==========================================
def prevent_shutdown():
    while True:
        try:
            ctypes.windll.kernel32.SetThreadExecutionState(0x80000002)
        except:
            pass
        time.sleep(1)
threading.Thread(target=prevent_shutdown, daemon=True).start()

# ==========================================
# 2. TERMAL KORUMAYI KAPAT
# ==========================================
try:
    subprocess.run('powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFINCPOL 2', shell=True)
    subprocess.run('powercfg -setacvalueindex SCHEME_CURRENT SUB_PROCESSOR PERFDECPOL 1', shell=True)
    subprocess.run('powercfg -setactive SCHEME_CURRENT', shell=True)
except:
    pass

# ==========================================
# 3. CPU ZORLAYICI (20 MİLYON İŞLEM)
# ==========================================
